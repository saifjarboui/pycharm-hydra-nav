<idea-plugin>
    <id>hydranav</id>
    <name>Hydra Defaults Navigation</name>
    <vendor url="https://github.com/saifjarboui/pycharm-hydra-nav">Saifeddine Jarboui</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.yaml</depends>
    <depends>PythonCore</depends>

    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor language="yaml"
                                  implementation="hydranav.HydraDefaultsReferenceContributor"/>
        <completion.contributor language="yaml" implementationClass="hydranav.HydraKwargCompletionContributor"/>
    </extensions>

    <projectListeners>
        <listener class="hydranav.ShowCommentsOnClose"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener$Before"/>
    </projectListeners>

    <applicationListeners>
        <listener class="hydranav.ShowCommentsOnProjectClose"
                  topic="com.intellij.openapi.project.ProjectCloseListener"/>
    </applicationListeners>

    <actions>
        <action id="hydranav.HideComments" class="hydranav.HideCommentsAction"
                text="HydraNav: Hide Comments and Docs" description="Toggle folding of all comments and docstrings">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="CodeMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
